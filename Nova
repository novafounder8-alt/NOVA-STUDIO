<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>NOVA Studio | Creativity, Precision & Impact</title>

<meta name="description" content="NOVA Studio is a creative digital studio focused on design, visual communication and impactful digital experiences.">

<style>
:root {
    --black: #080808;
    --white: #ffffff;
    --grey: #777777;
    --light: #f5f5f5;
    --border: #e8e8e8;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    color: var(--black);
    background: var(--white);
    line-height: 1.6;
}

a {
    text-decoration: none;
    color: inherit;
}

/* NAVIGATION */

nav {
    height: 85px;
    padding: 0 8%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--border);
    background: white;
    position: sticky;
    top: 0;
    z-index: 100;
}

.logo-container {
    display: flex;
    align-items: center;
    gap: 12px;
}

.star-logo {
    width: 28px;
    height: 28px;
    display: inline-block;
}

.logo {
    font-size: 27px;
    font-weight: 900;
    letter-spacing: 5px;
}

.nav-links {
    display: flex;
    gap: 35px;
    align-items: center;
}

.nav-links a {
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 1px;
    transition: opacity .3s;
}

.nav-links a:hover {
    opacity: .5;
}

.nav-contact {
    border: 1px solid black;
    padding: 12px 20px;
}

/* HERO */

.hero {
    min-height: 680px;
    padding: 120px 10%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: var(--white);
}

.eyebrow {
    font-size: 11px;
    letter-spacing: 4px;
    font-weight: bold;
    margin-bottom: 30px;
}

.hero h1 {
    font-size: clamp(55px, 10vw, 115px);
    line-height: .95;
    font-weight: 900;
    letter-spacing: -7px;
    max-width: 950px;
}

.hero h1 span {
    color: #a0a0a0;
}

.hero-description {
    max-width: 520px;
    color: var(--grey);
    font-size: 16px;
    margin-top: 35px;
}

.hero-actions {
    display: flex;
    gap: 15px;
    margin-top: 35px;
    flex-wrap: wrap;
}

.button {
    padding: 16px 27px;
    font-size: 11px;
    letter-spacing: 1.5px;
    font-weight: bold;
    display: inline-block;
    transition: .3s;
    cursor: pointer;
    border: none;
    background: none;
    text-align: center;
}

.button-black {
    background: black;
    color: white;
}

.button-black:hover {
    background: #444;
}

.button-outline {
    border: 1px solid black;
}

.button-outline:hover {
    background: black;
    color: white;
}

/* BRAND STATEMENT */

.statement {
    background: var(--black);
    color: white;
    padding: 100px 10%;
    text-align: center;
}

.statement .small-title {
    font-size: 11px;
    letter-spacing: 4px;
    color: #999;
}

.statement h2 {
    font-size: clamp(30px, 5vw, 55px);
    line-height: 1.25;
    margin: 30px auto;
    max-width: 850px;
}

.statement h2 span {
    color: #999;
}

.statement p {
    color: #aaa;
    font-size: 14px;
}

/* SERVICES */

.services {
    padding: 110px 10%;
}

.section-label {
    font-size: 11px;
    letter-spacing: 4px;
    font-weight: bold;
    color: var(--grey);
}

.section-heading {
    font-size: clamp(35px, 5vw, 55px);
    margin-top: 15px;
    margin-bottom: 55px;
    letter-spacing: -2px;
}

.service-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.service-card {
    padding: 35px 25px;
    border: 1px solid var(--border);
    min-height: 230px;
    transition: .3s;
}

.service-card:hover {
    border-color: black;
    transform: translateY(-5px);
}

.service-number {
    font-size: 12px;
    color: #999;
}

.service-card h3 {
    font-size: 21px;
    margin: 30px 0 12px;
}

.service-card p {
    color: var(--grey);
    font-size: 13px;
}

/* PORTFOLIO / ACTUAL DESIGNS */

.portfolio {
    padding: 110px 10%;
    background: var(--light);
}

.portfolio-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
    margin-top: 50px;
}

.portfolio-item {
    background: white;
    border: 1px solid var(--border);
    overflow: hidden;
    transition: .3s;
}

.portfolio-item:hover {
    border-color: black;
    transform: translateY(-5px);
}

.portfolio-img-placeholder {
    width: 100%;
    height: 280px;
    background: #111;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-weight: bold;
    letter-spacing: 2px;
    font-size: 14px;
    position: relative;
}

.portfolio-content {
    padding: 30px;
}

.portfolio-category {
    font-size: 11px;
    letter-spacing: 2px;
    color: var(--grey);
    font-weight: bold;
}

.portfolio-item h3 {
    font-size: 24px;
    margin: 10px 0 15px;
}

.portfolio-item p {
    color: var(--grey);
    font-size: 14px;
    margin-bottom: 20px;
}

/* ABOUT */

.about {
    padding: 110px 10%;
    background: var(--white);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
    align-items: center;
}

.about h2 {
    font-size: clamp(38px, 5vw, 60px);
    line-height: 1.1;
    letter-spacing: -3px;
    margin-top: 20px;
}

.about-text {
    color: #666;
    font-size: 15px;
}

.about-text p {
    margin-bottom: 20px;
}

/* PROJECT ENQUIRY SECTION */

.enquiry {
    padding: 110px 10%;
    background: var(--light);
}

.enquiry-container {
    max-width: 700px;
    margin: 0 auto;
    background: white;
    padding: 50px;
    border: 1px solid var(--border);
}

.enquiry-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 30px;
}

.form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.form-group label {
    font-size: 11px;
    letter-spacing: 1.5px;
    font-weight: bold;
}

.form-group input,
.form-group select,
.form-group textarea {
    padding: 15px;
    border: 1px solid var(--border);
    font-family: inherit;
    font-size: 14px;
    background: white;
    transition: border-color .3s;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
    outline: none;
    border-color: black;
}

.form-group textarea {
    resize: vertical;
    min-height: 140px;
}

.form-success {
    display: none;
    background: #000;
    color: white;
    padding: 20px;
    text-align: center;
    font-size: 13px;
    letter-spacing: 1px;
    margin-top: 20px;
}

/* CONTACT */

.contact {
    padding: 120px 10%;
    text-align: center;
}

.contact h2 {
    font-size: clamp(40px, 7vw, 75px);
    letter-spacing: -4px;
    line-height: 1.1;
    margin: 20px 0;
}

.contact p {
    color: var(--grey);
    margin-bottom: 30px;
}

/* FOOTER */

footer {
    background: black;
    color: white;
    padding: 45px 10%;
}

.footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
}

.footer-logo-container {
    display: flex;
    align-items: center;
    gap: 10px;
}

.footer-logo {
    font-size: 24px;
    font-weight: 900;
    letter-spacing: 5px;
}

footer p {
    font-size: 11px;
    color: #999;
}

.footer-links {
    display: flex;
    gap: 20px;
    font-size: 12px;
}

.footer-bottom {
    border-top: 1px solid #333;
    margin-top: 35px;
    padding-top: 20px;
    text-align: center;
}

/* MOBILE */

@media (max-width: 768px) {

    nav {
        height: 75px;
        padding: 0 6%;
    }

    .logo {
        font-size: 21px;
    }

    .nav-links {
        gap: 12px;
    }

    .nav-links a {
        font-size: 9px;
    }

    .nav-links a:not(.nav-contact) {
        display: none;
    }

    .hero {
        min-height: 600px;
        padding: 90px 7%;
    }

    .hero h1 {
        letter-spacing: -4px;
    }

    .statement,
    .services,
    .portfolio,
    .about,
    .enquiry,
    .contact {
        padding: 80px 7%;
    }

    .service-grid,
    .portfolio-grid {
        grid-template-columns: 1fr;
    }

    .about {
        grid-template-columns: 1fr;
        gap: 30px;
    }

    .enquiry-container {
        padding: 30px 20px;
    }

    .footer-content {
        flex-direction: column;
        text-align: center;
    }

    .footer-links {
        justify-content: center;
    }
}
</style>
</head>

<body>

<!-- NAVIGATION -->

<nav>
    <div class="logo-container">
        <!-- Official Star Shape Logo -->
        <svg class="star-logo" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M50 0C50 27.6142 27.6142 50 0 50C27.6142 50 50 72.3858 50 100C50 72.3858 72.3858 50 100 50C72.3858 50 50 27.6142 50 0Z" fill="#080808"/>
        </svg>
        <a href="#" class="logo">NOVA</a>
    </div>

    <div class="nav-links">
        <a href="#home">HOME</a>
        <a href="#services">SERVICES</a>
        <a href="#portfolio">PORTFOLIO</a>
