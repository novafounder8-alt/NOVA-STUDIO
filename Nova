        creativity and precision.
    </p>

    <div class="hero-actions">
        <a href="#portfolio" class="button button-black">
            EXPLORE OUR WORK
        </a>

        <a href="#enquiry" class="button button-outline">
            PROJECT ENQUIRY
        </a>
    </div>

</section>

<!-- BRAND STATEMENT -->

<section class="statement">

    <p class="small-title">THE NOVA STANDARD</p>

