            </p>
        </div>

    </div>

</section>

<!-- PROFESSIONAL PORTFOLIO / ACTUAL DESIGNS -->

<section class="portfolio" id="portfolio">

    <p class="section-label">PORTFOLIO</p>

    <h2 class="section-heading">
