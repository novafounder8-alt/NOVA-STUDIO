    <p class="section-label">LET'S CREATE SOMETHING</p>

    <h2>
        YOUR IDEA.<br>
        OUR CREATION.
    </h2>

    <p>
        Have a project in mind? Let's connect.
    </p>

    <a href="mailto:novafounder8@gmail.com"
       class="button button-black">
        CONTACT NOVA STUDIO
    </a>

    <br><br>

    <a href="https://wa.me/27703390719"
       class="button button-outline"
       target="_blank"
       rel="noopener">
        CHAT ON WHATSAPP
    </a>

</section>

<!-- FOOTER -->

<footer>

    <div class="footer-content">

        <div class="footer-logo-container">
            <svg class="star-logo" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M50 0C50 27.6142 27.6142 50 0 50C27.6142 50 50 72.3858 50 100C50 72.3858 72.3858 50 100 50C72.3858 50 50 27.6142 50 0Z" fill="white"/>
            </svg>
