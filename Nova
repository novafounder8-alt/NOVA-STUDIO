</nav>

<!-- HERO -->

<section class="hero" id="home">

    <p class="eyebrow">INDEPENDENT CREATIVE STUDIO</p>

    <h1>
        IDEAS INTO<br>
        <span>IMPACT.</span>
    </h1>

    <p class="hero-description">
        Welcome to NOVA Studio. We transform creative ideas
